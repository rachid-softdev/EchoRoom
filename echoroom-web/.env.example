# ─── App ───────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/echoroom?schema=public
DIRECT_URL=postgresql://user:pass@localhost:5432/echoroom?schema=public

# ─── Auth ──────────────────────────────────────────────
NEXTAUTH_SECRET=your-secret-at-least-32-chars-long
NEXTAUTH_URL=http://localhost:3000

# ─── Redis (Upstash) ───────────────────────────────────
REDIS_URL=https://your-key.upstash.io

# ─── Stripe ────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Twilio ────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_TOKEN_SECRET=your-hmac-secret-at-least-16-chars

# ─── OpenAI ────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── ElevenLabs ────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-key

# ─── Deepgram ──────────────────────────────────────────
DEEPGRAM_API_KEY=your-deepgram-key

# ─── Cloudflare R2 ─────────────────────────────────────
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=echoroom-recordings
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://public-bucket-url.example.com

# ─── PostHog (server-side, validated by env.ts) ────────
POSTHOG_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com

# ─── PostHog (client-side, validated by env.client.ts) ─
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Audit ─────────────────────────────────────────────
AUDIT_HASH_SECRET=change_me_to_a_random_secret_at_least_16_chars

# ─── Phone Encryption ──────────────────────────────────
PHONE_ENCRYPTION_KEY=your-256-bit-encryption-key-here-xx
