# ─── Staging Environment — terraform.tfvars example ────────────────────────────
# Copier ce fichier vers terraform.tfvars et remplacer les valeurs
# cp terraform.tfvars.example terraform.tfvars
#
# ATTENTION : Ne pas committer le fichier terraform.tfvars contenant des secrets.

# ─── Provider Credentials ──────────────────────────────────────────────────────
aiven_api_token        = "YOUR_AIVEN_API_TOKEN"
upstash_email          = "your-email@example.com"
upstash_api_key        = "YOUR_UPSTASH_API_KEY"
cloudflare_api_token   = "YOUR_CLOUDFLARE_API_TOKEN"

# ─── PostgreSQL ────────────────────────────────────────────────────────────────
pg_project     = "echoroom-staging"
pg_cloud_name  = "google-europe-west1"
pg_plan        = "startup-4"
pg_disk_size   = 50

# ─── Redis ─────────────────────────────────────────────────────────────────────
redis_region = "eu-west-1"
redis_tier   = "pay-as-you-go"

# ─── R2 ────────────────────────────────────────────────────────────────────────
cloudflare_account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"
r2_bucket_name        = "echoroom-recordings-staging"
r2_location           = "WEUR"
